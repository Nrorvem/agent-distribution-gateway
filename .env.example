# ============================================================================
# OPTION A: APOLLO.IO SUPPLY CONNECTOR
# ============================================================================
# Get your scoped API key from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# Set to "true" to test the entire 402 + MCP pipeline with realistic mock profiles
# without consuming real Apollo credits. Set to "false" for live Apollo API calls.
APOLLO_MOCK_MODE=false

# ============================================================================
# LAYER 3: x402 ZERO-AUTH PAYMENT GATE (USDC ON BASE)
# ============================================================================
# Your EVM wallet address on Base (Mainnet or Base Sepolia) that receives USDC
X402_WALLET_ADDRESS=0x7C38096030c9CF41Ec551dAcDFC1aBaA60590AbC

# Network: "base" (production USDC) or "base-sepolia" (testnet)
X402_NETWORK=base

# Price per Person Enrichment call in USD (e.g. $0.10 USDC)
X402_ENRICH_PRICE_USD=0.10

# Coinbase Official x402 Facilitator URL (auto-falls back to https://facilitator.payai.network if CDP keys omitted)
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Coinbase Developer Platform (CDP) API Key for Official Facilitator & Bazaar auto-indexing
CDP_API_KEY_ID=your_cdp_api_key_id_here
CDP_API_KEY_SECRET=your_cdp_api_key_secret_here

# Public URL of your deployed gateway (used in /.well-known/agent.json and llms.txt)
NEXT_PUBLIC_GATEWAY_URL=https://agent-distribution-gateway.vercel.app
